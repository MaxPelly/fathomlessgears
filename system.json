{
	"id": "fathomlessgears",
	"version": "#{VERSION}#",
	"title": "Fathomless Gears",
	"description": "A Foundry VTT system for Fathomless Gears, the mech fishing game by Ralf Ziegler",
	"authors": [
		{
			"name": "Natasha Pegler",
			"url": "https://github.com/twelfthrootoftwo"
		},
		{
			"name": "Max Pelly",
			"url": "https://github.com/MaxPelly"			
		}
	],
	"esmodules": ["src/fathomlessgears.js", "scripts/jszip.js"],
	"styles": [
		"styles/theme.css",
		"styles/sheet.css",
		"styles/dialogs.css",
		"styles/utils.css",
		"styles/chat.css",
		"styles/canvas.css",
		"styles/grid.css"
	],
	"packs": [
