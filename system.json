				"compatibility": {
					"minimum": "2.0.0-alpha1",
					"verified": "2.0.0-alpha1"
				}
			},
			{
				"id": "token-action-hud-core",
				"type": "module",
				"compatibility": {
					"minimum": "2.1.0",
					"verified": "2.1.1"
				}
			},
			{
				"id": "socketlib",
				"type": "module",
				"compatibility": {
					"minimum": "1.1.3",
					"verified": "1.1.4"
				}
			},
			{
				"id": "statuscounter",
				"type": "module",
				"compatibility": {
					"minimum": "3.0.3",
					"verified": "3.1.2"
				}
			}
		]
	},
	"grid": {
		"distance": 1,
		"units": ""
	},
	"type": "system",
	"url": "#{URL}#",
	"manifest": "#{MANIFEST}#",
	"download": "#{DOWNLOAD}#",
	"persistentStorage": true
