	"documentTypes": {
		"Actor": {
			"fish": {},
			"fisher": {"htmlFields": ["biography"]}
		},
		"Item": {
			"tag": {},
			"condition": {},
			"internal_pc": {},
			"internal_npc": {},
			"frame_pc": {},
